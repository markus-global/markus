{
  "name": "markus",
  "private": true,
  "type": "module",
  "description": "AI Native Digital Employee Platform",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:ts": "tsc -b",
    "dev": "pnpm build && concurrently -n api,ui -c blue,green \"node packages/cli/dist/index.js start\" \"node scripts/wait-for-api.mjs && pnpm --filter @markus/web-ui dev\"",
    "dev:api": "node packages/cli/dist/index.js start",
    "dev:ui": "pnpm --filter @markus/web-ui dev",
    "dev:watch": "pnpm build && concurrently -n tsc,api,ui -c gray,blue,green \"pnpm -r --parallel --filter=!@markus/web-ui dev\" \"node packages/cli/dist/index.js start\" \"node scripts/wait-for-api.mjs && pnpm --filter @markus/web-ui dev\"",
    "lint": "eslint packages/*/src/",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:web-ui": "vitest run --project web-ui",
    "test:watch": "vitest",
    "test:json": "vitest run --reporter=default --reporter=json --outputFile.json=coverage/vitest-report.json",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/vitest-report.json",
    "test:coverage:web-ui": "vitest run --config vitest.web-ui.coverage.config.ts",
    "coverage:node": "vitest run --project node --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reportsDirectory=./coverage/node",
    "test:skipped-audit": "node scripts/report-skipped-tests.mjs coverage/vitest-report.json",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.mjs",
    "coverage:ratchet:node": "node scripts/check-coverage-ratchet.mjs --project node",
    "typecheck": "tsc -b && tsc --noEmit -p packages/web-ui",
    "quality": "npm run typecheck && node scripts/architecture-guard.mjs && npm run test",
    "clean": "pnpm -r clean",
    "test:gui": "tsx test-gui-integration.ts",
    "example:gui": "tsx examples/gui-automation-workflow.ts",
    "example:release-notes": "tsx examples/release-notes-workflow.ts",
    "markus": "node packages/cli/dist/index.js",
    "build:publish": "pnpm build && pnpm --filter @markus/web-ui build && pnpm --filter @markus-global/cli build:bundle",
    "dev:desktop": "pnpm build && concurrently -n backend,vite,electron -c blue,green,magenta \"node packages/cli/dist/index.js start\" \"node scripts/wait-for-api.mjs && pnpm --filter @markus/web-ui dev\" \"wait-on http://localhost:8056/api/health && cd packages/desktop && ELECTRON_DEV=1 electron .\"",
    "build:desktop": "pnpm build && pnpm --filter @markus/web-ui build && pnpm --filter @markus/desktop build:electron"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3",
    "undici": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^15.11.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "node-datachannel",
      "node-pty"
    ]
  },
  "version": "0.10.0-rc.0"
}
